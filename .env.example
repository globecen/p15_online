# Configuration de sécurité Pristar P15 Docker
ADMIN_USERNAME=admin
# ADMIN_PASSWORD : si vide, l'interface vous demandera de définir votre mot de passe à la première connexion
# ADMIN_PASSWORD=votre-mot-de-passe-secret
SECRET_KEY=cle-secrete-a-personnaliser-pristar-p15-2026

# Port d'écoute du serveur web
PORT=8080

# Adresse MAC de l'imprimante Bluetooth (Optionnel : si renseigné, se connecte automatiquement au démarrage)
# PRINTER_MAC=AA:BB:CC:DD:EE:FF
